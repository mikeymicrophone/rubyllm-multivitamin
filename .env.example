# Copy to .env and fill in for a live run. .env is gitignored.
# Never commit a real key. Cassettes replay with no key at all.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Set LIVE=1 to record. LIVE_PROVIDER overrides the per-example provider
# for scripts that call Multivitamin::Models.chat. Tools and the spoken
# handover default to openai. Replay ignores LIVE_PROVIDER.
#   LIVE=1 LIVE_PROVIDER=openai OPENAI_API_KEY=... bundle exec rake test
#   LIVE=1 LIVE_PROVIDER=openrouter OPENROUTER_API_KEY=... bundle exec ruby path/to/example_test.rb
LIVE=
LIVE_PROVIDER=
